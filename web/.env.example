DATABASE_URL=
SONGDEE_ADMIN_PASSWORD=
SONGDEE_ADMIN_TOKEN_SECRET=
SONGDEE_CORS_ORIGIN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional proprietary service adapters. Configure these after their API contracts are supplied.
SONGDEE_DRIVER_IDENTITY_API_URL=
SONGDEE_GPS_MOTION_API_URL=
SONGDEE_DEVICE_GPS_API_URL=
SONGDEE_DEVICE_GPS_API_TOKEN=
# Native Data-FM standalone GPS adapter. When credentials are set, this takes precedence over SONGDEE_DEVICE_GPS_API_URL.
SONGDEE_DATA_FM_BASE_URL=https://www.data-fm.com
SONGDEE_DATA_FM_USERNAME=
SONGDEE_DATA_FM_PASSWORD=
# Explicit assumption required because the provider document does not define tracktime timezone semantics.
SONGDEE_DATA_FM_TIME_ZONE=Asia/Bangkok
SONGDEE_GPS_PAIR_TOLERANCE_SECONDS=60
