+  let timer;
+  let tick = 0;
+  let ended = false;
+  let failure = null;
+  let eventId = randomUUID();
+  let eventStartedAt = new Date();
+  let statusSessionId;
+  let alarmSessionId;
+  const readyWaiters = new Set();
+  const pendingAcks = new Map();
+  const sendQueues = new Map();
+  let emitting = false;
+  let position = { lat: 13.7563, lng: 100.5023 };
