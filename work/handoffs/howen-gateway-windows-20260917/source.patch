+  function rejectWaiters(error) {
+    for (const waiter of readyWaiters) { clearTimeout(waiter.timer); waiter.reject(error); }
+    readyWaiters.clear();
+    for (const waiter of pendingAcks.values()) { clearTimeout(waiter.timer); waiter.reject(error); }
+    pendingAcks.clear();
+  }
