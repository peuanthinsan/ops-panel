+    headingDegrees: directionRaw <= 180 ? directionRaw + (bit(info, 0) ? 180 : 0) : null,
+    altitudeRaw, altitudeBelowSeaLevel: bit(info, 2), altitudeMeters: altitudeRaw === 0 ? 0 : null,
