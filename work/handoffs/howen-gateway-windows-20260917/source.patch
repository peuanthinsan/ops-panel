+      states.set(zone.id, { inside, enteredAt, stoppedAt, visitId: inside ? visitId : null, lastTime: Number.isFinite(now) ? Math.max(now, previous.lastTime ?? now) : previous.lastTime });
+    }
+  }
+  return events;
