+      const waiter = { resolve, reject, timer: setTimeout(() => {
+        readyWaiters.delete(waiter);
+        reject(new Error('Timed out waiting for simulator registration and subscriptions'));
+      }, timeoutMs) };
+      readyWaiters.add(waiter);
+    });
+  }
