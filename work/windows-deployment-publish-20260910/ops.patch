diff --git a/hosting/build.cjs b/hosting/build.cjs
new file mode 100644
index 0000000..99f5a30
--- /dev/null
+++ b/hosting/build.cjs
@@ -0,0 +1,69 @@
+'use strict';
+const fs = require('node:fs');
+const path = require('node:path');
+const { spawnSync } = require('node:child_process');
+
+// Run from a clean checkout. Never supply production runtime credentials here.
+const root = path.resolve(__dirname, '..');
+const app = JSON.parse(fs.readFileSync(path.join(__dirname, 'app.json'), 'utf8')).app;
+const [configFile, output] = process.argv.slice(2);
+if (!configFile || !output) throw new Error('Usage: node hosting/build.cjs PUBLIC_BUILD_SETTINGS_JSON OUTPUT_DIRECTORY');
+const publicSettings = JSON.parse(fs.readFileSync(configFile, 'utf8').replace(/^\uFEFF/, ''));
+if (Object.keys(publicSettings).some(key => !/^NEXT_PUBLIC_[A-Z0-9_]+$/.test(key))) {
+  throw new Error('Build settings may contain only NEXT_PUBLIC_ values; never pass runtime secrets');
+}
+const destination = path.resolve(output);
+if (fs.existsSync(destination)) throw new Error('Output directory must not already exist');
+if (destination.startsWith(root + path.sep)) throw new Error('Output must be outside the source checkout');
+const env = {
+  ...process.env, ...publicSettings, NODE_ENV: 'production', NEXT_TELEMETRY_DISABLED: '1', SONGDEE_WINDOWS_HOSTING: '1',
+  DATABASE_URL: 'postgresql://build_only:dummy@127.0.0.1:54329/build_only',
+  POSTGRES_URL: 'postgresql://build_only:dummy@127.0.0.1:54329/build_only',
+  SONGDEE_ADMIN_TOKEN_SECRET: 'build-validation-only-not-a-production-secret',
+  AUTH_SECRET: 'build-validation-only-not-a-production-secret',
+};
+delete env.AUTH_URL;
+delete env.NEXTAUTH_URL;
+const npm = path.join(path.dirname(process.execPath), 'node_modules/npm/bin/npm-cli.js');
+function node(args, cwd = root, variables = env) {
+  const result = spawnSync(process.execPath, args, { cwd, env: variables, stdio: 'inherit', windowsHide: true });
+  if (result.error || result.status !== 0) throw new Error('Build command failed; exit code ' + result.status);
+}
+function install(cwd) {
+  node([npm, 'ci', '--include=dev', '--no-audit', '--no-fund'], cwd, {
+    ...process.env, NODE_ENV: 'development', NEXT_TELEMETRY_DISABLED: '1',
+  });
+}
+function copy(from, to) { fs.cpSync(from, to, { recursive: true, errorOnExist: true }); }
+if (app === 'dashboard') {
+  install(root);
+  node([path.join(root, 'node_modules/vitest/vitest.mjs'), 'run']);
+  node([path.join(root, 'node_modules/next/dist/bin/next'), 'build']);
+  copy(path.join(root, '.next/standalone'), destination);
+  if (fs.existsSync(path.join(root, 'public'))) copy(path.join(root, 'public'), path.join(destination, 'public'));
+  copy(path.join(root, '.next/static'), path.join(destination, '.next/static'));
+} else if (app === 'ops') {
+  const web = path.join(root, 'web');
+  install(web);
+  node([path.join(web, 'node_modules/next/dist/bin/next'), 'build'], web);
+  copy(path.join(web, '.next/standalone'), destination);
+  copy(path.join(web, 'public'), path.join(destination, 'web/public'));
+  copy(path.join(web, '.next/static'), path.join(destination, 'web/.next/static'));
+} else if (app === 'svis') {
+  install(root);
+  install(path.join(root, 'web'));
+  node(['--test', 'host/host-policy.test.cjs', 'host/proxy-headers.test.cjs']);
+  node([npm, 'run', 'build'], path.join(root, 'web'));
+  node(['host/build.cjs']);
+  fs.mkdirSync(destination, { recursive: true });
+  for (const dir of ['dist', 'public']) copy(path.join(root, dir), path.join(destination, dir));
+  // Use the repository lockfile for reproducible runtime dependency installation.
+  copy(path.join(root, 'package.json'), path.join(destination, 'package.json'));
+  copy(path.join(root, 'package-lock.json'), path.join(destination, 'package-lock.json'));
+  node([npm, 'ci', '--omit=dev', '--ignore-scripts', '--no-audit', '--no-fund'], destination, {
+    ...process.env, NODE_ENV: 'production',
+  });
+} else throw new Error('Unknown application');
+fs.mkdirSync(path.join(destination, 'hosting'), { recursive: true });
+for (const name of ['launch.cjs', 'app.json']) copy(path.join(__dirname, name), path.join(destination, 'hosting', name));
+console.log('Release packaged for ' + app);
diff --git a/hosting/launch.cjs b/hosting/launch.cjs
new file mode 100644
index 0000000..d6d6361
--- /dev/null
+++ b/hosting/launch.cjs
@@ -0,0 +1,26 @@
+'use strict';
+const fs = require('node:fs');
+const path = require('node:path');
+if (!process.env.SONGDEE_CONFIG) throw new Error('SONGDEE_CONFIG must identify the protected runtime JSON');
+const settings = JSON.parse(fs.readFileSync(process.env.SONGDEE_CONFIG, 'utf8').replace(/^\uFEFF/, ''));
+for (const [key, value] of Object.entries(settings)) {
+  if (!/^[A-Z][A-Z0-9_]*$/.test(key) || ['NODE_OPTIONS', 'PATH', 'NODE_PATH'].includes(key)) throw new Error('Invalid runtime setting name');
+  if (!['string', 'number', 'boolean'].includes(typeof value)) throw new Error('Invalid runtime setting value');
+  process.env[key] = String(value);
+}
+process.env.SONGDEE_WINDOWS_HOSTING = '1';
+process.env.NODE_ENV = 'production';
+process.env.HOST = process.env.HOSTNAME = '127.0.0.1';
+if (process.env.SONGDEE_CANDIDATE_PORT) {
+  if (!/^\d{4,5}$/.test(process.env.SONGDEE_CANDIDATE_PORT)) throw new Error('Invalid candidate port');
+  process.env.PORT = process.env.SONGDEE_CANDIDATE_PORT;
+}
+const { app } = JSON.parse(fs.readFileSync(path.join(__dirname, 'app.json'), 'utf8'));
+if (app === 'dashboard') {
+  delete process.env.AUTH_URL;
+  delete process.env.NEXTAUTH_URL;
+  process.env.AUTH_TRUST_HOST = 'true';
+  require('../server.js');
+} else if (app === 'ops') require('../web/server.js');
+else if (app === 'svis') require('../dist/server.cjs');
+else throw new Error('Unknown application');
