    "test:report-view": "node --test tests/report-view.test.ts",
    "test:server-contract": "node --test tests/server-contract.test.ts",
    "test:actions": "node --test tests/actions.test.ts",
    "test:active-job-finalization": "node --test tests/active-job-finalization.test.ts",
    "test:adapter-url": "node --test tests/adapter-url.test.ts",
    "server": "node server.js",
