    "test:android-release-config": "node --test tests/android-release-config.test.ts",
    "test:android-dev-launcher": "node --test tests/android-dev-launcher.test.ts",
    "test:branding": "node --test tests/branding.test.ts",
    "test:dashboard-accessibility": "node --test tests/dashboard-accessibility.test.ts",
    "test:database-schema": "node --test tests/database-schema.test.ts",
    "test:device-state": "node --test tests/device-state.test.ts",
    "test:driver-identity": "node --test tests/driver-identity.test.ts",
    "test:fleet-admin-state": "node --test tests/fleet-admin-state.test.ts",
    "test:mobile-ui": "node --test tests/mobile-ui.test.ts",
